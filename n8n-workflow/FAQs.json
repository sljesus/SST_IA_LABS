      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Verifica si no hay conversación: \n// - sin items, o \n// - el único item es un objeto vacío (sin propiedades)\nconst noConversation = items.length === 0 || \n    (items.length === 1 && Object.keys(items[0].json).length === 0);\n\n// Si hay conversación real, verifica que esté activa\nconst isActive = items.length > 0 && \n    items[0]?.json?.isActive === true;\n\nconst condition = noConversation || isActive;\n\nreturn [{ json: { condition } }];"
      },
