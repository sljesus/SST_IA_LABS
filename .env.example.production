# Variables de entorno para producción (GitHub Pages)
#
# Copia este archivo a .env.production y completa los valores:
# cp .env.example.production .env.production
#
# IMPORTANTE: Antes de hacer build, cambia kEnvName = 'production'
# en lib/backend/supabase/env_constants.dart
#
# Obtén las credenciales de tu proyecto Supabase de producción en:
# https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://tu-proyecto-produccion.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-produccion-aqui